rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == 'gj0UktB96BOo5UWO9Q4pZopSS6w1';
    }

    match /tasks/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /checklistItems/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /taskLinks/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /templates/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /linkedRules/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /manualBlocks/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /owners/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /categories/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /holidays/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /settings/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /meta/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /generatedKeys/{id} {
      allow read, create: if isOwner();
      // 오프라인인 두 기기가 같은 자동업무를 만들었을 때 두 번째 전송은
      // create가 아니라 update로 판정될 수 있다. 잠금의 핵심 값이 완전히
      // 같을 때만 멱등 재전송을 허용하고, 다른 업무 ID로 바꾸는 것은 막는다.
      allow update: if isOwner()
        && request.resource.data.generatedKey == resource.data.generatedKey
        && request.resource.data.taskId == resource.data.taskId;
      allow delete: if false;
    }
    match /changeLogs/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
