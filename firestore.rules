rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == '__OWNER_UID__';
    }

    match /tasks/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /checklistItems/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /taskLinks/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /templates/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /linkedRules/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /manualBlocks/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /owners/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /categories/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /holidays/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /settings/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /meta/{id} {
      allow read, create, update, delete: if isOwner();
    }
    match /generatedKeys/{id} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }
    match /changeLogs/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
